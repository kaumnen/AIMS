{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgePypi",
    ":maintainLockFilesMonthly",
    "schedule:weekly",
    ":semanticCommitScopeDisabled"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "src/aims/scenarios/**",
    "skills/aims/assets/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Workflow pins in env and run lines, each under a '# renovate: datasource=... depName=...' comment.",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n[^\\n]*?[:@](?<currentValue>v?\\d[^\\s@\"']*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "The project's own images. The release pins them by digest.",
      "matchPackageNames": ["ghcr.io/kaumnen/**"],
      "enabled": false
    },
    {
      "description": "One PR for the actions in the workflows.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "github-runner"],
      "groupName": "github actions"
    },
    {
      "description": "One PR for the minor and patch updates of the web dev dependencies.",
      "matchFileNames": ["web/package.json"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web dev dependencies"
    },
    {
      "description": "Python in .python-version and the Dockerfile moves together.",
      "matchDepNames": ["python"],
      "groupName": "python"
    },
    {
      "description": "Node in the workflows and the Dockerfile moves together.",
      "matchDepNames": ["node"],
      "groupName": "node"
    },
    {
      "description": "Bun in the workflows and the Dockerfile moves together.",
      "matchDepNames": ["bun", "oven/bun"],
      "groupName": "bun"
    },
    {
      "description": "uv in the workflows, the Dockerfile and the build backend moves together.",
      "matchDepNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv", "uv_build"],
      "groupName": "uv"
    },
    {
      "description": "One PR for image digests that changed under the same tag.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "groupName": "image digests"
    }
  ]
}
