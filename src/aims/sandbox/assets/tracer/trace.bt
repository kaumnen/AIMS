    printf("l %llu %llu %llu %llu %d %llu\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $sk);
  }
  if (has_key(@lbud, pid)) { delete(@lbud[pid]); }
}

tracepoint:sched:sched_process_exit /@lfound[tid].0 != 0 || @lmissop[tid] != 0 || @lbase[tid].0 != 0 || @lkpar[tid].0 != 0/ {
  if (@lkpar[tid].0 != 0) { if (has_key(@lkpar, tid)) { delete(@lkpar[tid]); } }
  if (@lfound[tid].0 != 0) { if (has_key(@lfound, tid)) { delete(@lfound[tid]); } }
  if (@lmissop[tid] != 0) { if (has_key(@lmissop, tid)) { delete(@lmissop[tid]); } if (has_key(@lmiss, tid)) { delete(@lmiss[tid]); } }
  if (@lbase[tid].0 != 0) { if (has_key(@lbase, tid)) { delete(@lbase[tid]); } }
