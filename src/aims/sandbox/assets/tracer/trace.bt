// 384 keeps the added dentry walks within the BPF stack budget.
config = { max_strlen = 384 }

BEGIN {
  @base = curtask->thread_pid->level;
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("R %llu %llu %llu %d %llu\n", nsecs(boot), cpu, $s, @base, nsecs(tai));
}

// One record per cpu each second, so a record lost at the end of a burst still leaves a hole.
// It runs in interrupt context, so its printf must fit on_stack_limit (32 bytes): a larger one
// shares the cpu's printf buffer with the probe it interrupts and overwrites that record.
profile:s:1 {
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("Q %llu %llu %llu\n", nsecs(boot), cpu, $s);
}

tracepoint:task:task_newtask /@sandbox[cgroup] && !(args.clone_flags & 0x10000)/ {
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("F %llu %llu %llu %d %d\n", nsecs(boot), cpu, $s, curtask->tgid, args.pid);
}

// A sandbox is a cgroup where a root process started a /.aims/ binary. The runner's helpers
// match too; their cgroups are unmarked on rmdir.
fentry:vmlinux:security_bprm_check /curtask->thread_pid->level > @base/ {
  $f = str(args.bprm->filename);
  if (!@sandbox[cgroup] && curtask->real_parent->thread_pid->level <= @base && strncmp($f, "/.aims/", 7) == 0) {
    @sandbox[cgroup] = 1;
  }
  if (@sandbox[cgroup]) {
    $s = @seq[cpu] + 1; @seq[cpu] = $s;
    printf("B %llu %llu %llu %d %s\n", nsecs(boot), cpu, $s, curtask->tgid, $f);
    $lf = args.bprm->file;
    $s = @seq[cpu] + 1; @seq[cpu] = $s;
    printf("L %llu %llu %llu %d %d %lu %lu %d %lu %lld %lld %lld\n", nsecs(boot), cpu, $s, curtask->tgid,
      curtask->real_parent->tgid, $lf->f_inode->i_ino, $lf->f_inode->i_sb->s_dev,
      $lf->f_inode->i_nlink, $lf->f_inode->i_sb->s_magic, $lf->f_inode->i_size,
      $lf->f_inode->i_mtime_sec * 1000000 + (int64)((uint64)$lf->f_inode->i_mtime_nsec / 1000),
      $lf->f_inode->i_ctime_sec * 1000000 + (int64)((uint64)$lf->f_inode->i_ctime_nsec / 1000));
    if ($lf->f_inode->i_nlink == 0 || strncmp($f, "/dev/fd/", 8) == 0
        || strncmp($f, "/proc/self/fd/", 14) == 0) {
      $s = @seq[cpu] + 1; @seq[cpu] = $s;
      printf("M %llu %llu %llu %d x %lu %d %s\n", nsecs(boot), cpu, $s, curtask->tgid,
        $lf->f_inode->i_ino, $lf->f_inode->i_nlink, $f);
    }
  }
}

tracepoint:cgroup:cgroup_rmdir /@sandbox[args.id]/ { delete(@sandbox[args.id]); }

tracepoint:sched:sched_process_exec /@sandbox[cgroup]/ {
  $tp = curtask->thread_pid;
  $ns = $tp->numbers[1].nr;
  $inum = $tp->numbers[1].ns->ns.inum;
  if ($tp->level == 0) { $ns = $tp->numbers[0].nr; $inum = $tp->numbers[0].ns->ns.inum; }
  if ($tp->level == 2) { $ns = $tp->numbers[2].nr; $inum = $tp->numbers[2].ns->ns.inum; }
  if ($tp->level == 3) { $ns = $tp->numbers[3].nr; $inum = $tp->numbers[3].ns->ns.inum; }
  $len = curtask->mm->arg_end - curtask->mm->arg_start;
  $fd = curtask->files->fdt->fd;
  $f0 = *($fd + 0); $f1 = *($fd + 1); $f2 = *($fd + 2);
  $pw = curtask->fs->pwd.dentry;
  $x = $pw; $kw = 0;
  unroll(12) { if ($x != $x->d_parent) { $kw++; $x = $x->d_parent; } }
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("V %llu %llu %llu %d %lu %u %u %lu %u %u %lu %u %u %u %d %s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s\n", nsecs(boot), cpu, $s,
    curtask->tgid, $f0->f_inode->i_ino, $f0->f_inode->i_mode, $f0->f_inode->i_sb->s_magic,
    $f1->f_inode->i_ino, $f1->f_inode->i_mode, $f1->f_inode->i_sb->s_magic,
    $f2->f_inode->i_ino, $f2->f_inode->i_mode, $f2->f_inode->i_sb->s_magic, $pw->d_sb->s_dev, $kw,
    str($pw->d_name.name),
    str($pw->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name));
  $ea = curtask->mm->env_start; $en = curtask->mm->env_end - $ea; $eo = (uint64)0;
  unroll(8) {
    if ($eo < $en) {
      $s = @seq[cpu] + 1; @seq[cpu] = $s;
      printf("G %llu %llu %llu %d %d %d %rx\n", nsecs(boot), cpu, $s, curtask->tgid, $en, $eo,
        buf(uptr($ea + $eo), $en - $eo > 512 ? 512 : $en - $eo));
      $eo += 512;
    }
  }
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("E %llu %llu %llu %d %d %d %d %u %d %d %rx\n", nsecs(boot), cpu, $s, curtask->tgid, curtask->real_parent->tgid,
    curtask->real_parent->thread_pid->level <= @base, curtask->cred->uid.val, $inum, $ns, $len,
    buf(uptr(curtask->mm->arg_start), $len));
}

// Once per process, when its last thread exits: an exec from a thread kills the old leader but
// not the process. Two threads exiting together can both see 0; the tracer drops the repeat.
// The status is the one wait() reports. live is read by offset: naming its anonymous atomic_t
// struct here makes bpftrace lose struct filename's anonymous head on 7.0 BTF.
tracepoint:sched:sched_process_exit /@sandbox[cgroup] && *(int32 *)((uint64)curtask->signal + offsetof(struct signal_struct, live)) == 0/ {
  $sg = curtask->signal;
  $c = ($sg->flags & 4) ? $sg->group_exit_code : curtask->group_leader->exit_code;
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("X %llu %llu %llu %d %d %d\n", nsecs(boot), cpu, $s, curtask->tgid, ($c >> 8) & 0xff, $c & 0x7f);
}

tracepoint:oom:mark_victim {
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("O %llu %llu %llu %d\n", nsecs(boot), cpu, $s, args.pid);
}

// Overlayfs makes its upper-layer calls with overridden creds; cred == real_cred keeps only the
// sandbox's own calls, not overlay's copy of them or its copy-up work.
fentry:vmlinux:security_file_open /@sandbox[cgroup] && curtask->thread_pid->level > @base && curtask->cred == curtask->real_cred && (args.file->f_inode->i_mode & 0xF000) == 0x8000/ {
  $p = path(args.file->f_path);
  if (args.file->f_mode & 2) {
    $s = @seq[cpu] + 1; @seq[cpu] = $s;
    printf("W %llu %llu %llu %d %s\n", nsecs(boot), cpu, $s, curtask->tgid, $p);
  } else {
    $keep = 0;
    if (strncmp($p, "/proc/", 6) == 0) {
      if (strncmp($p, "/proc/1/", 8) == 0 || strncmp($p, "/proc/sys/kernel/", 17) == 0
          || strncmp($p, "/proc/kallsyms", 15) == 0 || strncmp($p, "/proc/modules", 14) == 0
          || strncmp($p, "/proc/version", 14) == 0 || strncmp($p, "/proc/kcore", 12) == 0
          || strncmp($p, "/proc/meminfo", 13) == 0 || strncmp($p, "/proc/loadavg", 13) == 0
          || strncmp($p, "/proc/stat", 10) == 0 || strncmp($p, "/proc/uptime", 12) == 0) {
        $keep = 1;
      } else {
        $n = str(args.file->f_path.dentry->d_name.name);
        if (strncmp($n, "environ", 8) == 0 || strncmp($n, "maps", 5) == 0 || strncmp($n, "smaps", 6) == 0
            || strncmp($n, "mem", 4) == 0 || strncmp($n, "pagemap", 8) == 0 || strncmp($n, "auxv", 5) == 0
            || strncmp($n, "mounts", 7) == 0 || strncmp($n, "mountinfo", 10) == 0
            || strncmp($n, "cgroup", 7) == 0 || strncmp($n, "syscall", 8) == 0 || strncmp($n, "stack", 6) == 0) {
          $keep = 1;
        } else if (strncmp($n, "status", 7) == 0) {
          $pi = (struct proc_inode *)((uint64)args.file->f_inode - offsetof(struct proc_inode, vfs_inode));
          if ($pi->pid == curtask->thread_pid) { $keep = 1; }
        }
      }
    } else if (strncmp($p, "/sys/", 5) == 0) {
      if (strncmp($p, "/sys/fs/cgroup/", 15) == 0 || strncmp($p, "/sys/fs/bpf/", 12) == 0
          || strncmp($p, "/sys/kernel/tracing/", 20) == 0 || strncmp($p, "/sys/kernel/debug/", 18) == 0
          || strncmp($p, "/sys/kernel/security/", 21) == 0 || strncmp($p, "/sys/kernel/btf/", 16) == 0) {
        $keep = 1;
      }
    } else {
      if (strncmp($p, "/usr/", 5) != 0 && strncmp($p, "/lib", 4) != 0 && strncmp($p, "/dev/", 5) != 0
          && strncmp($p, "/etc/ld.so.cache", 16) != 0) {
        $keep = 1;
      }
    }
    if ($keep) {
      $s = @seq[cpu] + 1; @seq[cpu] = $s;
      printf("A %llu %llu %llu %d %s\n", nsecs(boot), cpu, $s, curtask->tgid, $p);
    }
  }
}

// The last reference to a file, on every path: close(2) on 6.8+ never reaches filp_close, and an
// exiting task releases its files after its X line. Overlay's backing files are skipped by
// FMODE_BACKING, bit 24 from 6.14; the tracer swaps in bit 25 on older kernels.
fentry:vmlinux:security_file_release /@sandbox[cgroup] && curtask->thread_pid->level > @base && (args.file->f_mode & 2) && !(args.file->f_mode & 0x1000000) && (args.file->f_inode->i_mode & 0xF000) == 0x8000/ {
  $d = args.file->f_path.dentry;
  $x = $d; $k = 0;
  unroll(12) { if ($x != $x->d_parent) { $k++; $x = $x->d_parent; } }
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("Z %llu %llu %llu %d %lld %u %d %s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s\n", nsecs(boot), cpu, $s, curtask->tgid, args.file->f_inode->i_size, $d->d_sb->s_dev, $k,
    str($d->d_name.name),
    str($d->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name));
}

