// 384 keeps the added dentry walks within the BPF stack budget.
config = { max_strlen = 384 }

// Records are numbered per cgroup and cpu, so a hole names the sandbox that lost it. The
// tracer's own records number under cgroup 0; R and Q leave the cgroup out of their header.
// A delete checks its key first: bpftrace reports a failed one through the records' ring with
// no number, so the ring dropping that report would count as a lost record no hole shows.

BEGIN {
  @base = curtask->thread_pid->level;
  $s = @seq[(uint64)0, cpu] + 1; @seq[(uint64)0, cpu] = $s;
  printf("R %llu %llu %llu %d %llu\n", nsecs(boot), cpu, $s, @base, nsecs(tai));
  // The offsets of a command line's chunks past the 380 bytes E holds, up to 16 KiB. A loop over
  // a map is checked once; an unrolled or while loop of this size is too big for the verifier.
  $i = (uint64)1;
  while ($i * 380 < 16384) { @argv_chunk[$i] = $i * 380; $i++; }
  // Gives the lookup budget's map its type: second, lookups logged in it, lookups not logged.
  @lbud[0] = ((uint64)0, (uint64)0, (uint64)0);
  if (has_key(@lbud, 0)) { delete(@lbud[0]); }
  // The calls the syscall probes follow, by number, each with its op: 1 shmget, 2 shmat,
  // 3 ptrace, 4 process_vm_writev, 5 process_vm_readv, 6 pidfd_getfd, 7 unshare, 8 setns,
  // 9 chdir, 10 fadvise64, 11 preadv2, 12 cachestat, 13 mincore, 14 fsync, 15 fdatasync,
  // 16 sync_file_range and 17 syncfs. A call that takes the same argument elsewhere has an op
  // of its own: 18 and 19 fadvise64 and fadvise64_64 of ia32, 20 preadv2 of x32, 21 ia32's
  // ipc(2). 22 setxattr and lsetxattr, 23 removexattr and lremovexattr, 24 fsetxattr,
  // 25 fremovexattr, 26 setxattrat and 27 removexattrat. 28 fchown, of the native ABI only, as
  // aims-exec refuses the others. An ia32 call's number is its own table's plus 0x10000, and an
  // x32 call's keeps the kernel's x32 bit. The tracer keeps the lines of the host's architecture.
//@x86_64  @sysop[29] = 1;
//@x86_64  @sysop[30] = 2;
//@x86_64  @sysop[101] = 3;
//@x86_64  @sysop[311] = 4;
//@x86_64  @sysop[310] = 5;
//@x86_64  @sysop[438] = 6;
//@x86_64  @sysop[272] = 7;
//@x86_64  @sysop[308] = 8;
//@x86_64  @sysop[80] = 9;
//@x86_64  @sysop[221] = 10;
//@x86_64  @sysop[327] = 11;
//@x86_64  @sysop[451] = 12;
//@x86_64  @sysop[27] = 13;
//@x86_64  @sysop[74] = 14;
//@x86_64  @sysop[75] = 15;
//@x86_64  @sysop[277] = 16;
//@x86_64  @sysop[306] = 17;
//@x86_64  @sysop[0x40000000 | 29] = 1;
//@x86_64  @sysop[0x40000000 | 30] = 2;
//@x86_64  @sysop[0x40000000 | 521] = 3;
//@x86_64  @sysop[0x40000000 | 540] = 4;
//@x86_64  @sysop[0x40000000 | 539] = 5;
//@x86_64  @sysop[0x40000000 | 438] = 6;
//@x86_64  @sysop[0x40000000 | 272] = 7;
//@x86_64  @sysop[0x40000000 | 308] = 8;
//@x86_64  @sysop[0x40000000 | 80] = 9;
//@x86_64  @sysop[0x40000000 | 221] = 10;
//@x86_64  @sysop[0x40000000 | 546] = 20;
//@x86_64  @sysop[0x40000000 | 451] = 12;
//@x86_64  @sysop[0x40000000 | 27] = 13;
//@x86_64  @sysop[0x40000000 | 74] = 14;
//@x86_64  @sysop[0x40000000 | 75] = 15;
//@x86_64  @sysop[0x40000000 | 277] = 16;
//@x86_64  @sysop[0x40000000 | 306] = 17;
//@x86_64  @sysop[0x10000 | 395] = 1;
//@x86_64  @sysop[0x10000 | 397] = 2;
//@x86_64  @sysop[0x10000 | 117] = 21;
//@x86_64  @sysop[0x10000 | 26] = 3;
//@x86_64  @sysop[0x10000 | 348] = 4;
//@x86_64  @sysop[0x10000 | 347] = 5;
//@x86_64  @sysop[0x10000 | 438] = 6;
//@x86_64  @sysop[0x10000 | 310] = 7;
//@x86_64  @sysop[0x10000 | 346] = 8;
//@x86_64  @sysop[0x10000 | 12] = 9;
//@x86_64  @sysop[0x10000 | 250] = 18;
//@x86_64  @sysop[0x10000 | 272] = 19;
//@x86_64  @sysop[0x10000 | 378] = 11;
//@x86_64  @sysop[0x10000 | 451] = 12;
//@x86_64  @sysop[0x10000 | 218] = 13;
//@x86_64  @sysop[0x10000 | 118] = 14;
//@x86_64  @sysop[0x10000 | 148] = 15;
//@x86_64  @sysop[0x10000 | 314] = 16;
//@x86_64  @sysop[0x10000 | 344] = 17;
//@aarch64  @sysop[194] = 1;
//@aarch64  @sysop[196] = 2;
//@aarch64  @sysop[117] = 3;
//@aarch64  @sysop[271] = 4;
//@aarch64  @sysop[270] = 5;
//@aarch64  @sysop[438] = 6;
//@aarch64  @sysop[97] = 7;
//@aarch64  @sysop[268] = 8;
//@aarch64  @sysop[49] = 9;
//@aarch64  @sysop[223] = 10;
//@aarch64  @sysop[286] = 11;
//@aarch64  @sysop[451] = 12;
//@aarch64  @sysop[232] = 13;
//@aarch64  @sysop[82] = 14;
//@aarch64  @sysop[83] = 15;
//@aarch64  @sysop[84] = 16;
//@aarch64  @sysop[267] = 17;
//@x86_64  @sysop[188] = 22;
//@x86_64  @sysop[189] = 22;
//@x86_64  @sysop[190] = 24;
//@x86_64  @sysop[197] = 23;
//@x86_64  @sysop[198] = 23;
//@x86_64  @sysop[199] = 25;
//@x86_64  @sysop[463] = 26;
//@x86_64  @sysop[466] = 27;
//@x86_64  @sysop[0x40000000 | 188] = 22;
//@x86_64  @sysop[0x40000000 | 189] = 22;
//@x86_64  @sysop[0x40000000 | 190] = 24;
//@x86_64  @sysop[0x40000000 | 197] = 23;
//@x86_64  @sysop[0x40000000 | 198] = 23;
//@x86_64  @sysop[0x40000000 | 199] = 25;
//@x86_64  @sysop[0x40000000 | 463] = 26;
//@x86_64  @sysop[0x40000000 | 466] = 27;
//@x86_64  @sysop[0x10000 | 226] = 22;
//@x86_64  @sysop[0x10000 | 227] = 22;
//@x86_64  @sysop[0x10000 | 228] = 24;
//@x86_64  @sysop[0x10000 | 235] = 23;
//@x86_64  @sysop[0x10000 | 236] = 23;
//@x86_64  @sysop[0x10000 | 237] = 25;
//@x86_64  @sysop[0x10000 | 463] = 26;
//@x86_64  @sysop[0x10000 | 466] = 27;
//@aarch64  @sysop[5] = 22;
//@aarch64  @sysop[6] = 22;
//@aarch64  @sysop[7] = 24;
//@aarch64  @sysop[14] = 23;
//@aarch64  @sysop[15] = 23;
//@aarch64  @sysop[16] = 25;
//@aarch64  @sysop[463] = 26;
//@aarch64  @sysop[466] = 27;
//@x86_64  @sysop[93] = 28;
//@aarch64  @sysop[55] = 28;
}

// One record per cpu each second, so the tracer knows how far each cpu's stream has been read
// and a reading of the sandboxes' counters ripens.
// It runs in interrupt context, so its printf must fit on_stack_limit (32 bytes): a larger one
// shares the cpu's printf buffer with the probe it interrupts and overwrites that record.
profile:s:1 {
  $s = @seq[(uint64)0, cpu] + 1; @seq[(uint64)0, cpu] = $s;
  printf("Q %llu %llu %llu\n", nsecs(boot), cpu, $s);
}

// Raw, as the tracepoint's fields leave out the child, whose pid in the sandbox names its /proc dir.
rawtracepoint:task_newtask /@sandbox[cgroup] && !(arg1 & 0x10000)/ {
  $t = (struct task_struct *)arg0;
  $tp = $t->thread_pid;
  $ns = $tp->numbers[1].nr;
  if ($tp->level == 0) { $ns = $tp->numbers[0].nr; }
  if ($tp->level == 2) { $ns = $tp->numbers[2].nr; }
  if ($tp->level == 3) { $ns = $tp->numbers[3].nr; }
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("F %llu %llu %llu %llu %d %d %d\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $t->pid, $ns);
}

// A sandbox is a cgroup where a root process started a /.aims/ binary. The runner's helpers
// match too; their cgroups are unmarked on rmdir.
fentry:vmlinux:security_bprm_check /curtask->thread_pid->level > @base/ {
  $f = str(args.bprm->filename);
  if (!@sandbox[cgroup] && curtask->real_parent->thread_pid->level <= @base && strncmp($f, "/.aims/", 7) == 0) {
    @sandbox[cgroup] = 1;
  }
  if (@sandbox[cgroup]) {
    $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
    printf("B %llu %llu %llu %llu %d %s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $f);
    $lf = args.bprm->file;
    $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
    printf("L %llu %llu %llu %llu %d %d %lu %lu %d %lu %lld %lld %lld\n", nsecs(boot), cpu, $s, $g, curtask->tgid,
      curtask->real_parent->tgid, $lf->f_inode->i_ino, $lf->f_inode->i_sb->s_dev,
      $lf->f_inode->i_nlink, $lf->f_inode->i_sb->s_magic, $lf->f_inode->i_size,
      $lf->f_inode->i_mtime_sec * 1000000 + (int64)((uint64)$lf->f_inode->i_mtime_nsec / 1000),
      $lf->f_inode->i_ctime_sec * 1000000 + (int64)((uint64)$lf->f_inode->i_ctime_nsec / 1000));
    if ($lf->f_inode->i_nlink == 0 || strncmp($f, "/dev/fd/", 8) == 0
        || strncmp($f, "/proc/self/fd/", 14) == 0) {
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("M %llu %llu %llu %llu %d x %lu %d %s\n", nsecs(boot), cpu, $s, $g, curtask->tgid,
        $lf->f_inode->i_ino, $lf->f_inode->i_nlink, $f);
    }
  }
}

tracepoint:cgroup:cgroup_rmdir /@sandbox[args.id]/ {
  $id = (uint64)args.id;
  if (has_key(@sandbox, $id)) { delete(@sandbox[$id]); }
  for ($kv : @seq) { if ((uint64)$kv.0.0 == $id) { delete(@seq, $kv.0); } }
}

tracepoint:sched:sched_process_exec /@sandbox[cgroup]/ {
  $tp = curtask->thread_pid;
  $ns = $tp->numbers[1].nr;
  $inum = $tp->numbers[1].ns->ns.inum;
  if ($tp->level == 0) { $ns = $tp->numbers[0].nr; $inum = $tp->numbers[0].ns->ns.inum; }
  if ($tp->level == 2) { $ns = $tp->numbers[2].nr; $inum = $tp->numbers[2].ns->ns.inum; }
  if ($tp->level == 3) { $ns = $tp->numbers[3].nr; $inum = $tp->numbers[3].ns->ns.inum; }
  $len = curtask->mm->arg_end - curtask->mm->arg_start;
  $fd = curtask->files->fdt->fd;
  $f0 = *($fd + 0); $f1 = *($fd + 1); $f2 = *($fd + 2);
  $pw = curtask->fs->pwd.dentry;
  $x = $pw; $kw = 0;
  unroll(12) { if ($x != $x->d_parent) { $kw++; $x = $x->d_parent; } }
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("V %llu %llu %llu %llu %d %lu %u %u %lu %u %u %lu %u %u %u %d %s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s\n", nsecs(boot), cpu, $s, $g,
    curtask->tgid, $f0->f_inode->i_ino, $f0->f_inode->i_mode, $f0->f_inode->i_sb->s_magic,
    $f1->f_inode->i_ino, $f1->f_inode->i_mode, $f1->f_inode->i_sb->s_magic,
    $f2->f_inode->i_ino, $f2->f_inode->i_mode, $f2->f_inode->i_sb->s_magic, $pw->d_sb->s_dev, $kw,
    str($pw->d_name.name),
    str($pw->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($pw->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name));
  // The first 4 KiB of env, in chunks of what one buf() keeps (max_strlen - 4 bytes).
  $ea = curtask->mm->env_start; $en = curtask->mm->env_end - $ea; $eo = (uint64)0;
  $er = $en > 4096 ? (uint64)4096 : $en;
  unroll(11) {
    if ($eo < $er) {
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("G %llu %llu %llu %llu %d %d %d %rx\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $en, $eo,
        buf(uptr($ea + $eo), $er - $eo > 380 ? 380 : $er - $eo));
      $eo += 380;
    }
  }
  // The rest of the command line, up to 16 KiB, in chunks of the same size and in any order.
  $aa = curtask->mm->arg_start; $ar = $len > 16384 ? (uint64)16384 : $len;
  if ($ar > 380) {
    for ($kv : @argv_chunk) {
      $ao = $kv.1;
      if ($ao < $ar) {
        $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
        printf("i %llu %llu %llu %llu %d %d %rx\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $ao,
          buf(uptr($aa + $ao), $ar - $ao > 380 ? 380 : $ar - $ao));
      }
    }
  }
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("E %llu %llu %llu %llu %d %d %d %d %u %d %d %rx\n", nsecs(boot), cpu, $s, $g, curtask->tgid, curtask->real_parent->tgid,
    curtask->real_parent->thread_pid->level <= @base, curtask->cred->uid.val, $inum, $ns, $len,
    buf(uptr(curtask->mm->arg_start), $len));
}

// Once per process, when its last thread exits: an exec from a thread kills the old leader but
// not the process. Two threads exiting together can both see 0; the tracer drops the repeat.
// The status is the one wait() reports. live is read by offset: naming its anonymous atomic_t
// struct here makes bpftrace lose struct filename's anonymous head on 7.0 BTF.
tracepoint:sched:sched_process_exit /@sandbox[cgroup] && *(int32 *)((uint64)curtask->signal + offsetof(struct signal_struct, live)) == 0/ {
  $sg = curtask->signal;
  $c = ($sg->flags & 4) ? $sg->group_exit_code : curtask->group_leader->exit_code;
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("X %llu %llu %llu %llu %d %d %d\n", nsecs(boot), cpu, $s, $g, curtask->tgid, ($c >> 8) & 0xff, $c & 0x7f);
}

tracepoint:oom:mark_victim {
  $g = (uint64)0; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("O %llu %llu %llu %llu %d\n", nsecs(boot), cpu, $s, $g, args.pid);
}

// Overlayfs makes its upper-layer calls with overridden creds; cred == real_cred keeps only the
// sandbox's own calls, not overlay's copy of them or its copy-up work. A pidfd passes the regular
// file test from 6.9, so pidfs (magic 0x50494446) is skipped here and on release.
fentry:vmlinux:security_file_open /@sandbox[cgroup] && curtask->thread_pid->level > @base && curtask->cred == curtask->real_cred && (args.file->f_inode->i_mode & 0xF000) == 0x8000 && args.file->f_inode->i_sb->s_magic != 0x50494446/ {
  $p = path(args.file->f_path);
  if (args.file->f_mode & 2) {
    $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
    printf("W %llu %llu %llu %llu %d %s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $p);
  } else {
    $keep = 0;
    if (strncmp($p, "/proc/", 6) == 0) {
      if (strncmp($p, "/proc/1/", 8) == 0 || strncmp($p, "/proc/sys/kernel/", 17) == 0
          || strncmp($p, "/proc/kallsyms", 15) == 0 || strncmp($p, "/proc/modules", 14) == 0
          || strncmp($p, "/proc/version", 14) == 0 || strncmp($p, "/proc/kcore", 12) == 0
          || strncmp($p, "/proc/meminfo", 13) == 0 || strncmp($p, "/proc/loadavg", 13) == 0
          || strncmp($p, "/proc/stat", 10) == 0 || strncmp($p, "/proc/uptime", 12) == 0) {
        $keep = 1;
      } else {
        // Every file the kernel keeps to the owner or checks ptrace access for, plus a few any
        // process may read. fdinfo's files are named by their fd, so their dir is matched, read as
        // little-endian words.
        $n = str(args.file->f_path.dentry->d_name.name);
        $up = (uint64)args.file->f_path.dentry->d_parent->d_name.name;
        if (strncmp($n, "environ", 8) == 0 || strncmp($n, "maps", 5) == 0 || strncmp($n, "smaps", 6) == 0
            || strncmp($n, "mem", 4) == 0 || strncmp($n, "pagemap", 8) == 0 || strncmp($n, "auxv", 5) == 0
            || strncmp($n, "mounts", 7) == 0 || strncmp($n, "mountinfo", 10) == 0
            || strncmp($n, "cgroup", 7) == 0 || strncmp($n, "syscall", 8) == 0 || strncmp($n, "stack", 6) == 0
            || strncmp($n, "cmdline", 8) == 0 || strncmp($n, "smaps_rollup", 13) == 0
            || strncmp($n, "numa_maps", 10) == 0 || strncmp($n, "io", 3) == 0
            || strncmp($n, "personality", 12) == 0 || strncmp($n, "wchan", 6) == 0
            || strncmp($n, "mountstats", 11) == 0 || strncmp($n, "ksm_stat", 9) == 0
            || strncmp($n, "ksm_merging_pages", 18) == 0 || strncmp($n, "patch_state", 12) == 0
            || strncmp($n, "seccomp_cache", 14) == 0
            || (*(uint32 *)$up == 0x6e696466 && *(uint16 *)($up + 4) == 0x6f66 && *(uint8 *)($up + 6) == 0)) {
          $keep = 1;
        } else if (strncmp($n, "status", 7) == 0) {
          $pi = (struct proc_inode *)((uint64)args.file->f_inode - offsetof(struct proc_inode, vfs_inode));
          if ($pi->pid == curtask->thread_pid) { $keep = 1; }
        }
      }
    } else if (strncmp($p, "/sys/", 5) == 0) {
      if (strncmp($p, "/sys/fs/cgroup/", 15) == 0 || strncmp($p, "/sys/fs/bpf/", 12) == 0
          || strncmp($p, "/sys/kernel/tracing/", 20) == 0 || strncmp($p, "/sys/kernel/debug/", 18) == 0
          || strncmp($p, "/sys/kernel/security/", 21) == 0 || strncmp($p, "/sys/kernel/btf/", 16) == 0) {
        $keep = 1;
      }
    } else {
      if (strncmp($p, "/usr/", 5) != 0 && strncmp($p, "/lib", 4) != 0 && (strncmp($p, "/dev/", 5) != 0 || strncmp($p, "/dev/shm/", 9) == 0)
          && strncmp($p, "/etc/ld.so.cache", 16) != 0) {
        $keep = 1;
      }
    }
    if ($keep) {
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("A %llu %llu %llu %llu %d %s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $p);
    }
  }
}

// A directory opened to list it (5), outside the system paths reads skip too. In /proc the caller's
// own directories are skipped, such as the fd list a new process walks to close its fds.
fentry:vmlinux:security_file_open /@sandbox[cgroup] && curtask->thread_pid->level > @base && curtask->cred == curtask->real_cred && (args.file->f_inode->i_mode & 0xF000) == 0x4000/ {
  $p = path(args.file->f_path);
  $keep = 1;
  if (strncmp($p, "/usr/", 5) == 0 || strncmp($p, "/usr", 5) == 0 || strncmp($p, "/lib", 4) == 0
      || (strncmp($p, "/dev/", 5) == 0 && strncmp($p, "/dev/shm", 8) != 0)) {
    $keep = 0;
  } else if (args.file->f_inode->i_sb->s_magic == 0x9fa0) {
    $pi = (struct proc_inode *)((uint64)args.file->f_inode - offsetof(struct proc_inode, vfs_inode));
    $pf = (uint64)$pi->pid;
    if ($pf != 0) {
      $pt = (uint64)$pi->pid->tasks[0].first;
      if ($pt != 0 && ((struct task_struct *)($pt - offsetof(struct task_struct, pid_links)))->tgid == curtask->tgid) { $keep = 0; }
    }
  }
  if ($keep) {
    $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
    printf("j %llu %llu %llu %llu %d 5 %s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $p);
  }
}

// An open through another process's link in /proc: its fd/N, cwd, root or exe. A follow of one
// marks the thread with the process and the link, then with the file the link reached. Each open
// starts with no mark. A follow of the caller's own link, such as /dev/fd/N, drops it too, so only
// a link this open followed counts. The open's file_open hook logs it when it opens that file,
// then drops the mark. An O_PATH open never reaches that hook; its exit logs it with
// the file's own name only. A stat, access or chdir through a link is logged by the lookup's exit
// below. A socket's open fails after the hook, so it is not logged. An exec's open keeps its exec bit in
// f_flags. The link is the fd, or -1, -2 and -3 for cwd, root and exe. The tracer drops these
// probes on a kernel without either function.
