  $pp = $ei->pid;
  $pf = (uint64)$pp->tasks[0].first;
  if ($pf != 0) {
    $tg = ((struct task_struct *)($pf - offsetof(struct task_struct, pid_links)))->tgid;
    if ($tg != curtask->tgid) {
      $n = $pp->numbers[1].nr;
      if ($pp->level == 0) { $n = $pp->numbers[0].nr; }
      if ($pp->level == 2) { $n = $pp->numbers[2].nr; }
      if ($pp->level == 3) { $n = $pp->numbers[3].nr; }
      $c = *(uint8 *)args.dentry->d_name.name;
      $k = (int64)$ei->fd;
