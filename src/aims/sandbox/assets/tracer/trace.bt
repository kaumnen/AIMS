// A refused fchown, logged at the call's exit with the file its fd names. Some builds inline
// vfs_fchown into ksys_fchown and others ksys_fchown into the syscall, so no one function sees
// every call. The fd is looked up again at exit, so a thread that closes it first leaves the call
// unlogged, and one that puts another file on the fd first has that file logged.
//@x86_64 tracepoint:raw_syscalls:sys_exit /args.id == 93 && @fch[tid].0 != 0/ {
//@aarch64 tracepoint:raw_syscalls:sys_exit /args.id == 55 && @fch[tid].0 != 0/ {
  $fc = @fch[tid];
  if (has_key(@fch, tid)) { delete(@fch[tid]); }
  $r = args.ret;
  $fd = (int64)$fc.1;
  $fdt = curtask->files->fdt;
  if (($r == -1 || $r == -13 || $r == -30) && $fd >= 0 && (uint64)$fd < (uint64)$fdt->max_fds) {
    $f = *($fdt->fd + $fd);
    if ($f != 0) {
      $d = (*(struct path *)((uint64)$f + offsetof(struct file, f_path))).dentry;
      $x = $d; $k = 0;
      unroll(12) { if ($x != $x->d_parent) { $k++; $x = $x->d_parent; } }
      if ($k == 12 && $x != $x->d_parent) {
        $i = 0;
        while ($i < 4 && $x != $x->d_parent) {
          $w = $x; $c = 0;
          unroll(12) { if ($x != $x->d_parent) { $c++; $x = $x->d_parent; } }
          $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
          printf("w %llu %llu %llu %llu %d 0 %d %s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $c,
            str($w->d_name.name),
            str($w->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
            str($w->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name));
          $i++;
        }
      }
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("t %llu %llu %llu %llu %d o %d %lld %lld %lld %lld %lld %u %d %s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, -$r,
        (int64)$fc.2, (int64)$fc.3, 0, 0, 0, $d->d_sb->s_dev, $k,
        str($d->d_name.name),
        str($d->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
        str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name));
    }
  }
}

tracepoint:sched:sched_process_exit /@fch[tid].0 != 0/ { if (has_key(@fch, tid)) { delete(@fch[tid]); } }

// A refused call, numbered as BEGIN's table numbers it.
tracepoint:raw_syscalls:sys_exit /args.ret == -1 && @sandbox[cgroup]/ {
  $id = args.id;
//@x86_64  if ((curtask->thread_info.status & 2) != 0) { $id = $id | 0x10000; }
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("D %llu %llu %llu %llu %d %lld %d\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $id, -args.ret);
}

// From 6.15 the tracer attaches anon_pipe_write and fifo_pipe_write here instead; anon_pipe_write
// keeps only pipefs files, since a FIFO write through fifo_pipe_write may call it too.
fentry:vmlinux:pipe_write /@sandbox[cgroup] && curtask->thread_pid->level > @base
    && (probe != "fentry:vmlinux:anon_pipe_write" || args.iocb->ki_filp->f_inode->i_sb->s_magic == 0x50495045)/ {
  $f = args.iocb->ki_filp; $it = args.from; $ino = $f->f_inode->i_ino; $n = $it->count;
  $m = $f->f_inode->i_sb->s_magic;
  $a = (uint64)0; $na = (uint64)0; $b = (uint64)0; $nb = (uint64)0; $cap = (uint64)64;
  if (@opipe[curtask->tgid, $ino] == 0) {
    if ($it->iter_type == 0) {
      $a = (uint64)$it->ubuf + $it->iov_offset;
      $na = $n > $cap ? $cap : $n;
    } else if ($it->iter_type == 1) {
      // writev: the prefix spans the first two non-empty segments of the first eight.
      $v = $it->__iov; $ns = $it->nr_segs; $i = (uint64)0;
      $la = $v->iov_len - $it->iov_offset;
      unroll(7) { if ($la == 0 && $i + 1 < $ns) { $i++; $la = ($v + $i)->iov_len; } }
      $a = (uint64)($v + $i)->iov_base + ($i == 0 ? $it->iov_offset : 0);
      $na = $la > $cap ? $cap : $la;
      $j = $i + 1; $lb = (uint64)0;
      unroll(7) { if ($lb == 0 && $j < $ns && $j < 8) { $lb = ($v + $j)->iov_len; $j++; } }
      if ($na < $cap && $lb > 0) {
        $b = (uint64)($v + $j - 1)->iov_base;
        $nb = $lb > $cap - $na ? $cap - $na : $lb;
      }
    }
    if ($na + $nb > 0) { @opipe[curtask->tgid, $ino] = 1; }
  }
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("T %llu %llu %llu %llu %d %lu %u %lu %rx%rx\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $ino, $m, $n,
    buf(uptr($a), $na), buf(uptr($b), $nb));
}

// clear() would go through the ring, where a drop is loss no sequence hole explains.
interval:s:5 { for ($kv : @opipe) { delete(@opipe, $kv.0); } }
