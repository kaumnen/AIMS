    $sa->ia_ctime.tv_sec * 1000000 + (int64)((uint64)$sa->ia_ctime.tv_nsec / 1000),
    str($sd->d_name.name),
    str($sd->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
    str($sd->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name));
