// The target is read up to its NUL, so bytes left in the buffer after it are never printed.
// Its length is printed too: buf() keeps at most max_strlen - 4 bytes.
fentry:vmlinux:security_inode_symlink /@sandbox[cgroup] && curtask->thread_pid->level > @base && curtask->cred == curtask->real_cred/ {
  $d = args.dentry;
