// From 6.15 the tracer attaches anon_pipe_write and fifo_pipe_write here instead; anon_pipe_write
// keeps only pipefs files, since a FIFO write through fifo_pipe_write may call it too.
fentry:vmlinux:pipe_write /@sandbox[cgroup] && curtask->thread_pid->level > @base
    && (probe != "fentry:vmlinux:anon_pipe_write" || args.iocb->ki_filp->f_inode->i_sb->s_magic == 0x50495045)/ {
  $f = args.iocb->ki_filp; $it = args.from; $ino = $f->f_inode->i_ino; $n = $it->count;
  $m = $f->f_inode->i_sb->s_magic;
  $a = (uint64)0; $na = (uint64)0; $b = (uint64)0; $nb = (uint64)0; $cap = (uint64)64;
  if (@opipe[curtask->tgid, $ino] == 0) {
    if ($it->iter_type == 0) {
      $a = (uint64)$it->ubuf + $it->iov_offset;
      $na = $n > $cap ? $cap : $n;
    } else if ($it->iter_type == 1) {
      // writev: the prefix spans the first two non-empty segments of the first eight.
      $v = $it->__iov; $ns = $it->nr_segs; $i = (uint64)0;
      $la = $v->iov_len - $it->iov_offset;
      unroll(7) { if ($la == 0 && $i + 1 < $ns) { $i++; $la = ($v + $i)->iov_len; } }
      $a = (uint64)($v + $i)->iov_base + ($i == 0 ? $it->iov_offset : 0);
      $na = $la > $cap ? $cap : $la;
      $j = $i + 1; $lb = (uint64)0;
      unroll(7) { if ($lb == 0 && $j < $ns && $j < 8) { $lb = ($v + $j)->iov_len; $j++; } }
      if ($na < $cap && $lb > 0) {
        $b = (uint64)($v + $j - 1)->iov_base;
        $nb = $lb > $cap - $na ? $cap - $na : $lb;
      }
    }
    if ($na + $nb > 0) { @opipe[curtask->tgid, $ino] = 1; }
  }
  $s = @seq[cpu] + 1; @seq[cpu] = $s;
  printf("T %llu %llu %llu %d %lu %u %lu %rx%rx\n", nsecs(boot), cpu, $s, curtask->tgid, $ino, $m, $n,
    buf(uptr($a), $na), buf(uptr($b), $nb));
}

// clear() would go through the ring, where a drop is loss no sequence hole explains.
interval:s:5 { for ($kv : @opipe) { delete(@opipe, $kv.0); } }
