// Refused opens, with the kernel's copy of the name so a racing thread cannot change what is
// logged. 7.0 renamed do_filp_open to do_file_open; the tracer picks the name. 7.0 also moved
// `name` into an anonymous head, which bpftrace 0.23 loses once probes reading fd tables are
// loaded, so it is read at its offset, 0 on every kernel. A relative name comes with the walk of
// the directory it was looked up from, the cwd or the file dfd names; -1 as the depth means none.
// The walk's names are hex, so the name can come last whatever bytes it holds.
fexit:vmlinux:do_filp_open /@sandbox[cgroup] && curtask->thread_pid->level > @base && ((int64)retval == -1 || (int64)retval == -13 || (int64)retval == -30)/ {
  $d = curtask->fs->pwd.dentry; $k = -1;
  if (strncmp(str(*(uint64 *)args.pathname), "/", 1) != 0) {
    if (args.dfd == -100) { $k = 0; } else {
      $fdt = curtask->files->fdt;
      if ((int64)args.dfd >= 0 && (uint64)args.dfd < (uint64)$fdt->max_fds) {
        $f = *($fdt->fd + args.dfd);
        if ($f != 0) { $d = (*(struct path *)((uint64)$f + offsetof(struct file, f_path))).dentry; $k = 0; }
      }
    }
    if ($k == 0) { $x = $d; unroll(12) { if ($x != $x->d_parent) { $k++; $x = $x->d_parent; } } }
  }
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("P %llu %llu %llu %llu %d %d %u %d %rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx %s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, -(int64)retval, $d->d_sb->s_dev, $k,
    buf($d->d_name.name, $d->d_name.len),
    buf($d->d_parent->d_name.name, $d->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
    buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
    str(*(uint64 *)args.pathname));
}

// A directory rename may change the path of a directory a thread's last lookup was beneath, so
// the lookups below print that directory again after one.
fentry:vmlinux:security_inode_rename /@sandbox[cgroup] && curtask->thread_pid->level > @base && curtask->cred == curtask->real_cred && (args.old_dentry->d_inode->i_mode & 0xF000) == 0x4000/ { @rengen = @rengen + 1; }

// Looking a name up without opening it: stat (1), access (2), readlink (3) and chdir (4). Each
// call marks the thread with its op and the lookup's exit logs it, with the kernel's copy of the
// name. A found name is logged as what it reached, so a symlink, `..` or a relative name cannot
// hide where it led: a stat by its path from the attribute check that follows, the rest by the
// walk. Under the root's usr, lib*, bin and sbin that is skipped, as are the caller's own /proc
// entries but for its namespaces, cgroup and mounts. A missed name is logged as given, with the
// walk of the directory a relative one was looked up from. One under those system paths is
// skipped unless it holds `..`, as is the loader's check for /etc/ld.so.preload, which every exec
// makes. The errno is the lookup's: access's own answer and a readlink of what is no link come
// after it. The tracer drops each op whose call it cannot attach to.
// A walk fills the ring as a dozen names do, so a loop of lookups would outrun the reader. A
// thread's lookup that repeats its last one, found or missed, is skipped. One beneath the
// directory of the thread's last of its kind prints -3 as its depth and no walk of it. Each prints
// the thread, the directory's address and the count of directory renames, and the tracer joins a
// -3 one to the walk it kept for that thread only when both match. A name the kernel could not
// copy, such as an empty one, is never looked up.
fentry:vmlinux:vfs_statx /@sandbox[cgroup] && curtask->thread_pid->level > @base/ { @look[tid] = 1; }
fexit:vmlinux:vfs_statx /@look[tid] != 0/ { if (has_key(@look, tid)) { delete(@look[tid]); } if (@getattr[tid] != 0) { if (has_key(@getattr, tid)) { delete(@getattr[tid]); } } }
fentry:vmlinux:do_faccessat /@sandbox[cgroup] && curtask->thread_pid->level > @base/ { @look[tid] = 2; }
fexit:vmlinux:do_faccessat /@look[tid] != 0/ { if (has_key(@look, tid)) { delete(@look[tid]); } }
fentry:vmlinux:do_readlinkat /@sandbox[cgroup] && curtask->thread_pid->level > @base/ { @look[tid] = 3; }
fexit:vmlinux:do_readlinkat /@look[tid] != 0/ { if (has_key(@look, tid)) { delete(@look[tid]); } }
// chdir's mark is set and dropped by the syscall probes.

fexit:vmlinux:filename_lookup /@look[tid] != 0 && retval == 0/ {
  $op = @look[tid];
  $d = args.path->dentry;
  $h = *(uint64 *)((uint64)$d + offsetof(struct dentry, d_name));
  $last = @lfound[tid];
  $keep = 1;
  if ($last.0 == $op && $last.1 == (uint64)$d && $last.2 == $h) { $keep = 0; }
  $x = $d; $c1 = $d; $c2 = $d; $k = 0;
  unroll(12) { if ($x != $x->d_parent) { $k++; $c2 = $c1; $c1 = $x; $x = $x->d_parent; } }
  // Names are matched as little-endian words, which keeps the stack within its limit.
  if ($keep && $x == $x->d_parent) {
    $t = (uint64)$c1->d_name.name;
    $t4 = *(uint32 *)$t;
    if ($d->d_sb == curtask->fs->root.dentry->d_sb && $x == curtask->fs->root.dentry
        && ($t4 == 0x727375 || ($t4 & 0xffffff) == 0x62696c || $t4 == 0x6e6962
            || ($t4 == 0x6e696273 && *(uint8 *)($t + 4) == 0))) {
      $keep = 0;
    } else if ($d->d_sb->s_magic == 0x9fa0 && $k > 1) {
