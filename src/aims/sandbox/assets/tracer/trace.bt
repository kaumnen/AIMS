    if ($p->level == 0) { $n = $p->numbers[0].nr; }
    if ($p->level == 2) { $n = $p->numbers[2].nr; }
    if ($p->level == 3) { $n = $p->numbers[3].nr; }
    @getfd_ns[tid] = $n;
    $f = (uint64)$p->tasks[0].first;
    if ($f != 0) {
      @ptrace_task[tid] = (int64)((struct task_struct *)($f - offsetof(struct task_struct, pid_links)))->tgid + 1;
    }
  }
}

// The syscalls of BEGIN's table, through raw_syscalls rather than each call's own tracepoint: a
// 64-bit kernel's syscall tracepoints skip an ia32 call (int 0x80) and an x32 one, and from 7.0
// they often miss a call that takes a path. An ia32 call's arguments are 32 bits wide; the rest
// of each register is not the caller's to set. shmget, shmat and mincore are logged here.
// ptrace, process_vm_writev and _readv, pidfd_getfd, unshare, setns and chdir mark the thread,
// and the exit probe below logs them. fchown keeps its arguments for an exit probe of its own. The page-cache calls that reveal whether another sandbox
// has touched the same host pages, and the durability calls, are logged with the file the fd
// names when the task still holds it; -1 as the depth means no file. They share one printf, as
// seven would push the probe past the reach of a BPF jump.
tracepoint:raw_syscalls:sys_enter /@sandbox[cgroup] && curtask->thread_pid->level > @base/ {
  $id = args.id;
  $w = (uint64)0xffffffffffffffff;
//@x86_64  if ((curtask->thread_info.status & 2) != 0) { $id = $id | 0x10000; $w = 0xffffffff; }
  $op = @sysop[$id];
  if ($op != 0) {
    $p0 = (uint64)args.args[0] & $w; $p1 = (uint64)args.args[1] & $w; $p2 = (uint64)args.args[2] & $w;
    $p3 = (uint64)args.args[3] & $w; $p4 = (uint64)args.args[4] & $w; $p5 = (uint64)args.args[5] & $w;
    // ipc(2) names its call in the low half of its first argument: SHMAT is 21 and SHMGET 23.
    if ($op == 21) {
      $c = $p0 & 0xffff;
      $op = 0;
      if ($c == 23) { $op = 1; $p0 = $p1; $p1 = $p2; $p2 = $p3; }
      if ($c == 21) { $op = 2; $p0 = $p1; }
    }
    if ($op == 1) {
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("I %llu %llu %llu %llu %d g 2 %d %lu %d\n", nsecs(boot), cpu, $s, $g, curtask->tgid, (int32)$p0, $p1, (int32)$p2);
    } else if ($op == 2) {
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("I %llu %llu %llu %llu %d a 2 %d %d\n", nsecs(boot), cpu, $s, $g, curtask->tgid, (int32)$p0, (int32)$p2);
    } else if ($op == 3) {
      @ptrace_req[tid] = (int64)$p0 + 1;
      @ptrace_pid[tid] = (int32)$p1;
      if (has_key(@ptrace_task, tid)) { delete(@ptrace_task[tid]); }
    } else if ($op == 4) {
      @vmw[tid] = (int32)$p0 + 1;
      if (has_key(@ptrace_task, tid)) { delete(@ptrace_task[tid]); }
    } else if ($op == 5) {
      @vmr[tid] = (int32)$p0 + 1;
      if (has_key(@ptrace_task, tid)) { delete(@ptrace_task[tid]); }
    } else if ($op == 6) {
      @getfd[tid] = 1;
      if (has_key(@getfd_ns, tid)) { delete(@getfd_ns[tid]); }
      if (has_key(@ptrace_task, tid)) { delete(@ptrace_task[tid]); }
    } else if ($op == 7) {
      @unshare[tid] = $p0 + 1;
    } else if ($op == 8) {
      @setns[tid] = (int32)$p1 + 1;
    } else if ($op == 9) {
      @look[tid] = 4;
    } else if ($op == 28) {
      @fch[tid] = (1, (int32)$p0, (int32)$p1, (int32)$p2);
    } else if ($op >= 22 && $op <= 27) {
      // A call on a file descriptor names no path: the walk is the file's. The names are copied
      // at entry, as the kernel copies them, so a racing thread can change what is logged.
      if (has_key(@xl, tid)) { delete(@xl[tid]); }
      @xo[tid] = 1; @xs[tid] = (uint64)0; @xf[tid] = 0; @xd[tid] = -100;
      if ($op == 23 || $op == 25 || $op == 27) { @xo[tid] = 2; }
      if ($op == 22 || $op == 24) { @xs[tid] = $p3; @xf[tid] = (int32)$p4; }
      if ($op == 24 || $op == 25) { @xd[tid] = (int32)$p0; }
      if ($op >= 26) { @xd[tid] = (int32)$p0; }
      if ($op == 22 || $op == 23) {
        @xp[tid] = str(uptr($p0)); @xn[tid] = str(uptr($p1));
      } else if ($op == 24 || $op == 25) {
        @xp[tid] = str(uptr($p1), 0); @xn[tid] = str(uptr($p1));
      } else {
        @xp[tid] = str(uptr($p1)); @xn[tid] = str(uptr($p3));
      }
    } else if ($op == 13) {
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("d %llu %llu %llu %llu %d\n", nsecs(boot), cpu, $s, $g, curtask->tgid);
    } else {
      // $l is the code of the record's letter: a for fadvise's DONTNEED (4), b for preadv2's
      // RWF_NOWAIT (8), then c cachestat, e fsync, f fdatasync, g sync_file_range and h syncfs.
      $l = 0;
      if (($op == 10 && $p3 == 4) || ($op == 18 && $p4 == 4) || ($op == 19 && $p5 == 4)) { $l = 97; }
      if (($op == 11 && ($p5 & 0x8)) || ($op == 20 && ($p4 & 0x8))) { $l = 98; }
      if ($op == 12) { $l = 99; }
      if ($op == 14) { $l = 101; }
      if ($op == 15) { $l = 102; }
      if ($op == 16) { $l = 103; }
      if ($op == 17) { $l = 104; }
      if ($l != 0) {
        $fd = (int64)(int32)$p0;
        $fdt = curtask->files->fdt; $d = curtask->fs->pwd.dentry; $k = -1;
        if ($fd >= 0 && (uint64)$fd < (uint64)$fdt->max_fds) {
          $f = *($fdt->fd + $fd);
          if ($f != 0) {
            $d = (*(struct path *)((uint64)$f + offsetof(struct file, f_path))).dentry; $x = $d; $k = 0;
            unroll(12) { if ($x != $x->d_parent) { $k++; $x = $x->d_parent; } }
          }
        }
        $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
        printf("%c %llu %llu %llu %llu %d %u %d %s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s/%s\n", (uint8)$l, nsecs(boot), cpu, $s, $g, curtask->tgid,
          $d->d_sb->s_dev, $k,
          str($d->d_name.name),
          str($d->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name),
          str($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name));
      }
    }
    if (($op >= 3 && $op <= 9) || ($op >= 22 && $op <= 27)) { @scx[tid] = ($op, args.id); }
  }
}

// A marked call's exit, when it is the call that marked the thread.
tracepoint:raw_syscalls:sys_exit /@scx[tid].0 != 0/ {
  $mk = @scx[tid];
  if (has_key(@scx, tid)) { delete(@scx[tid]); }
  if ($mk.1 == args.id) {
    $op = $mk.0;
    $r = args.ret;
    if ($op == 3) {
      $rq = @ptrace_req[tid] - 1;
      $tg = (int64)@ptrace_task[tid] - 1;
      if ($rq == 0) { $tg = curtask->real_parent->tgid; }
      $ns = @ptrace_pid[tid];
      if (has_key(@ptrace_req, tid)) { delete(@ptrace_req[tid]); }
      if (has_key(@ptrace_pid, tid)) { delete(@ptrace_pid[tid]); }
      if (has_key(@ptrace_task, tid)) { delete(@ptrace_task[tid]); }
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("K %llu %llu %llu %llu %d %lld %llu %lld %lld\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $tg, $rq, $r, $ns);
    } else if ($op == 4 || $op == 5) {
      $vt = @vmw[tid] - 1;
      $kind = -1;
      if ($op == 5) { $vt = @vmr[tid] - 1; $kind = -2; }
      $tg = (int64)@ptrace_task[tid] - 1;
      if (has_key(@vmw, tid)) { delete(@vmw[tid]); }
      if (has_key(@vmr, tid)) { delete(@vmr[tid]); }
      if (has_key(@ptrace_task, tid)) { delete(@ptrace_task[tid]); }
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("K %llu %llu %llu %llu %d %lld %lld %lld %lld\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $tg, $kind, $r, $vt);
    } else if ($op == 6) {
      $tg = (int64)@ptrace_task[tid] - 1;
      $vt = @getfd_ns[tid];
      if (has_key(@getfd, tid)) { delete(@getfd[tid]); }
      if (has_key(@getfd_ns, tid)) { delete(@getfd_ns[tid]); }
      if (has_key(@ptrace_task, tid)) { delete(@ptrace_task[tid]); }
      $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
      printf("K %llu %llu %llu %llu %d %lld -3 %lld %lld\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $tg, $r, $vt);
    } else if ($op == 7) {
      $nf = @unshare[tid] - 1;
      if (has_key(@unshare, tid)) { delete(@unshare[tid]); }
      if ($r == 0 && ($nf & 0x7E020080) != 0) {
        $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
        printf("J %llu %llu %llu %llu %d u %llu\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $nf);
      }
    } else if ($op == 8) {
      $sf = @setns[tid] - 1;
      if (has_key(@setns, tid)) { delete(@setns[tid]); }
      if ($r == 0) {
        $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
        printf("J %llu %llu %llu %llu %d n %llu\n", nsecs(boot), cpu, $s, $g, curtask->tgid, $sf);
      }
    } else if ($op == 9) {
      if (has_key(@look, tid)) { delete(@look[tid]); }
    } else if ($op >= 22 && $op <= 27) {
      // A refused extended attribute call, unless its inode hook logged it.
      if (@xl[tid] == 0 && ($r == -1 || $r == -13 || $r == -30)) {
        $d = curtask->fs->pwd.dentry; $k = -1;
        if (strncmp(@xp[tid], "/", 1) != 0) {
          if (@xd[tid] == -100) { $k = 0; } else {
            $fdt = curtask->files->fdt;
            if ((int64)@xd[tid] >= 0 && (uint64)@xd[tid] < (uint64)$fdt->max_fds) {
              $f = *($fdt->fd + @xd[tid]);
              if ($f != 0) { $d = (*(struct path *)((uint64)$f + offsetof(struct file, f_path))).dentry; $k = 0; }
            }
          }
          if ($k == 0) { $x = $d; unroll(12) { if ($x != $x->d_parent) { $k++; $x = $x->d_parent; } } }
        }
        $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
        printf("y %llu %llu %llu %llu %d %d %d %llu %d %rx %u %d %rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx/%rx %s\n", nsecs(boot), cpu, $s, $g, curtask->tgid, @xo[tid], -$r, @xs[tid], @xf[tid],
          buf(@xn[tid], 256), $d->d_sb->s_dev, $k,
          buf($d->d_name.name, $d->d_name.len),
          buf($d->d_parent->d_name.name, $d->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
          buf($d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.name, $d->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_parent->d_name.len),
          @xp[tid]);
      }
      if (has_key(@xo, tid)) { delete(@xo[tid]); }
      if (has_key(@xs, tid)) { delete(@xs[tid]); }
      if (has_key(@xf, tid)) { delete(@xf[tid]); }
      if (has_key(@xd, tid)) { delete(@xd[tid]); }
      if (has_key(@xp, tid)) { delete(@xp[tid]); }
      if (has_key(@xn, tid)) { delete(@xn[tid]); }
      if (has_key(@xl, tid)) { delete(@xl[tid]); }
    }
  }
}

tracepoint:sched:sched_process_exit /@scx[tid].0 != 0/ { if (has_key(@scx, tid)) { delete(@scx[tid]); } }

fentry:vmlinux:security_task_kill /@sandbox[cgroup] && curtask->thread_pid->level > @base
    && args.p->tgid != curtask->tgid && args.sig != 17/ {
  $g = cgroup; $s = @seq[$g, cpu] + 1; @seq[$g, cpu] = $s;
  printf("S %llu %llu %llu %llu %d %d %d\n", nsecs(boot), cpu, $s, $g, curtask->tgid, args.p->tgid, args.sig);
}

fentry:vmlinux:security_mmap_file /@sandbox[cgroup] && curtask->thread_pid->level > @base && args.file != 0
    && (args.prot & 4) != 0 && (args.file->f_inode->i_mode & 0xF000) == 0x8000
